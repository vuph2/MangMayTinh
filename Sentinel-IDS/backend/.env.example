# Copy file nay thanh ".env" (tuy chon). Moi bien deu co gia tri mac dinh.
PORT=3000
# 127.0.0.1 = chi may nay truy cap. Dat 0.0.0.0 neu user o may khac trong mang (IP user khi do chi backend thay).
BIND_HOST=127.0.0.1
# Nguon Frontend duoc phep goi API (CORS), cach nhau bang dau phay
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_PORT=5173
# Tai khoan admin mac dinh: admin / admin1234
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234
# true = moi lan chay backend se ep admin ve dung thong tin tren (doi mat khau trong giao dien se bi reset khi restart).
# Dat false neu muon tu doi mat khau admin trong giao dien va giu nguyen.
ADMIN_FORCE=true
# Khoa ma hoa mat khau VM / token. De trong = tu sinh vao data/secret.key
APP_SECRET=
# Host mo cac cong tunnel (127.0.0.1 hoac 0.0.0.0)
TUNNEL_BIND_HOST=127.0.0.1
 